#!/bin/bash
# i3blocks: ear = radio app launcher. Shows which SDR app is running.
. ~/.config/i3/scripts/common.sh
[ -n "$BLOCK_BUTTON" ] && setsid -f ~/.config/i3/scripts/sdr-menu >/dev/null 2>&1
ACTIVE=""
systemctl is-active -q "$ADSB_SERVICE" && ACTIVE="ADS-B"
for p in gqrx:GQRX sdrpp:SDR++ satdump-ui:SatDump rtl_433:433 acarsdec:ACARS dumpvdl2:VDL2 direwolf:APRS \
         AIS-catcher:AIS rtl_airband:Airband welle-io:DAB+ rtl_power:Scan; do
  pgrep -x "${p%%:*}" >/dev/null && ACTIVE="${p#*:}"
done
pgrep -f auto_rx.py >/dev/null && ACTIVE="$L_ACTIVE_SONDES"
# Audio modes (FT8, SSTV, fldigi...): rtl_fm feeds the virtual audio cable
MODE_FILE="${XDG_RUNTIME_DIR:-/tmp}/ubonsole-audio-mode"
pgrep -f "pw-cat --playback --raw --target ubonsole_sdr" >/dev/null && [ -f "$MODE_FILE" ] && ACTIVE=$(cat "$MODE_FILE")
echo $'\uf2a2'"${ACTIVE:+ $ACTIVE}"
