#!/bin/bash
# App launcher ($mod+d): themed rofi, larger text
exec rofi -show run \
  -theme "$HOME/.config/i3/scripts/rofi-theme.rasi" \
  -theme-str '* { font: "DejaVu Sans Mono 14"; } window { location: center; anchor: center; width: 640px; } mainbox { children: [ inputbar, listview ]; } listview { lines: 8; }'
