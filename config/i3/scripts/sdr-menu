#!/bin/bash
# Radio app launcher (rofi). Only one SDR app at a time: the dongle is freed before each launch.
. ~/.config/i3/scripts/common.sh
pkill -f "rofi -dmenu -p radio" && exit 0

THEME=(-theme "$ROFI_THEME" -theme-str 'window { location: north; anchor: north; y-offset: 32px; width: 560px; } listview { lines: 15; } mainbox { children: [ listview ]; }')

has() { command -v "$1" >/dev/null 2>&1; }
mark() { has "$1" || echo "  $L_NOT_INSTALLED"; }

# Power the AIO v2 SDR if it is off (no-op without the board)
sdr_power() {
  if has_aio && ! aio 2>/dev/null | grep -q '^SDR: ON'; then aio SDR on >/dev/null 2>&1; sleep 2; fi
}
# Device readsb is configured for (index or serial), from /etc/default/readsb
readsb_device() { sed -n 's/.*--device[ =]\([^ "]*\).*/\1/p' /etc/default/readsb 2>/dev/null | head -1; }

free_sdr() {
  pkill -x gqrx; pkill -x sdrpp; pkill -x satdump-ui; pkill -x satdump
  pkill -x rtl_433; pkill -x rtl_fm; pkill -x acarsdec; pkill -x dumpvdl2; pkill -x direwolf
  pkill -x AIS-catcher; pkill -x rtl_airband; pkill -x welle-io; pkill -x rtl_power
  pkill -f auto_rx.py; pkill -f scripts/adsb; pkill -f scripts/band-scan
  close_decoders
  ~/.config/i3/scripts/sdr-audio stop
  # ADS-B keeps running when the app about to start uses another dongle
  if systemctl is-active -q "$ADSB_SERVICE"; then
    local rd; rd=$(readsb_device)
    if [ -z "$DEV_INDEX" ] || [ -z "$rd" ] || [ "$rd" = "$DEV_INDEX" ] || [ "$rd" = "$DEV_SERIAL" ]; then
      sudo -n systemctl stop "$ADSB_SERVICE"
    fi
  fi
  sdr_power
  sleep 1
}

# Dongle for apps that cannot pick one themselves. Asked only when several are plugged in, with
# SDR_DEVICE (index or serial) preselected. Sets DEV_INDEX, DEV_SERIAL and DEV_NAME.
DEV_INDEX="" DEV_SERIAL="" DEV_NAME=""
pick_sdr() {
  sdr_power
  local sdrs=() lines=() sel=0 i idx ser name
  mapfile -t sdrs < <(list_sdrs)
  if [ ${#sdrs[@]} -eq 0 ]; then DEV_INDEX=$SDR_DEVICE; return; fi
  for i in "${!sdrs[@]}"; do
    IFS=$'\t' read -r idx ser name <<< "${sdrs[i]}"
    lines+=("$name · SN $ser")
    { [ "$idx" = "$SDR_DEVICE" ] || [ "$ser" = "$SDR_DEVICE" ]; } && sel=$i
  done
  if [ ${#sdrs[@]} -gt 1 ]; then
    sel=$(printf '%s\n' "${lines[@]}" | rofi -dmenu -p sdr -no-custom -format i -selected-row "$sel" \
      -mesg "$L_PICK_SDR" -theme "$ROFI_THEME" \
      -theme-str "window { location: north; anchor: north; y-offset: 32px; width: 560px; } mainbox { children: [ message, listview ]; } listview { lines: ${#sdrs[@]}; }")
    [ -z "$sel" ] && exit 0
  fi
  IFS=$'\t' read -r DEV_INDEX DEV_SERIAL DEV_NAME <<< "${sdrs[sel]}"
}
# Audio decoders listen to the SDR through the virtual cable: they go with it. WSJT-X and JS8Call
# are closed through i3 so they save their settings; QSSTV would ask for confirmation: SIGTERM.
close_decoders() {
  i3-msg -q '[class="(?i)^(wsjt-x|js8call)$"] kill' >/dev/null 2>&1
  pkill -x qsstv; pkill -x fldigi
  for _ in $(seq 25); do pgrep -x '(wsjtx|js8call|qsstv|fldigi)' >/dev/null || break; sleep 0.2; done
  # Still open (a dialog was showing): SIGTERM
  pkill -x wsjtx; pkill -x js8call
}
# Text-mode decoder in a terminal (workspace 3) that stays open when it exits
term() {
  # Translated strings go through the environment so quotes in them are safe
  # shellcheck disable=SC2059
  BANNER=$(printf "$L_LISTENING" "$3") CLOSE=$L_PRESS_ENTER_CLOSE \
    setsid -f st -c sdr-term -t "$1" -e bash -c 'echo "$BANNER"; echo; '"$2"'; read -rp "$CLOSE"' >/dev/null 2>&1
}
# Audio modes: rtl_fm demodulates into the virtual audio cable (scripts/sdr-audio), which is the
# default input while it runs, so WSJT-X / QSSTV / fldigi hear the SDR without any setting.
# audio_rx <MHz> <usb|lsb|am|fm> <label shown by the ear block>
audio_rx() {
  local rate=12000 extra=""
  [ "$2" = fm ] && rate=24000
  # Below 24 MHz an R820T dongle (AIO v2, V3) needs direct sampling on the Q branch; the RTL-SDR
  # Blog V4 has a built-in HF upconverter instead
  if awk -v f="$1" 'BEGIN { exit !(f < 24) }'; then
    case $DEV_NAME in *"Blog V4"*) ;; *) extra="-E direct2" ;; esac
  fi
  ~/.config/i3/scripts/sdr-audio start
  echo "$3" > "${XDG_RUNTIME_DIR:-/tmp}/ubonsole-audio-mode"
  setsid -f bash -c "rtl_fm -d ${DEV_INDEX:-$SDR_DEVICE} -M $2 -f ${1}M -s $rate -g $SDR_GAIN $extra - 2>/dev/null \
    | pw-cat --playback --raw --target ubonsole_sdr --rate $rate --channels 1 --format s16 - 2>/dev/null"
}
# pick <prompt> <lines...>: small submenu, prints the chosen index
pick() {
  local prompt=$1; shift
  printf '%s\n' "$@" | rofi -dmenu -p "$prompt" -i -no-custom -format i "${THEME[@]}" \
    -theme-str "listview { lines: $#; }"
}
# Other frequency: asks MHz and demodulation, then starts audio_rx
custom_rx() {
  local f m
  # rofi 1.7 crashes when a dmenu layout has no listview: keep it, hidden
  f=$(rofi -dmenu -p "$L_FREQ_PROMPT" -theme "$ROFI_THEME" -theme-str 'window { location: north; anchor: north; y-offset: 32px; width: 560px; } mainbox { children: [ inputbar, listview ]; } listview { enabled: false; }' </dev/null | tr ',' '.')
  [[ $f =~ ^[0-9]+(\.[0-9]+)?$ ]] || exit 0
  m=$(printf '%s\n' usb lsb am fm | rofi -dmenu -p "$L_MODE_PROMPT" -no-custom "${THEME[@]}" -theme-str 'listview { lines: 4; }')
  [ -n "$m" ] && audio_rx "$f" "$m" "$1"
}
# WSJT-X: receive-only defaults, written before it starts (it rewrites its settings on exit)
wsjtx_prepare() {
  python3 - "$1" <<'WSJTX'
import configparser, os, sys
path = os.path.expanduser("~/.config/WSJT-X.ini")
c = configparser.RawConfigParser(); c.optionxform = str
c.read(path)
for section in ("Common", "Configuration"):
    if not c.has_section(section):
        c.add_section(section)
c.set("Common", "Mode", sys.argv[1])
c.set("Configuration", "PSKReporter", "false")          # never upload what is received
# WSJT-X lists PulseAudio source names: record from the virtual cable created by sdr-audio
c.set("Configuration", "SoundInName", "ubonsole_sdr_in")
with open(path, "w") as f:
    c.write(f, space_around_delimiters=False)
WSJTX
}
# fldigi: without a settings file it opens a first-run wizard and records nothing. Make sure it
# records from PulseAudio (the default input = the virtual cable) and never spots online.
fldigi_prepare() {
  python3 - <<'FLDIGI'
import os, re
path = os.path.expanduser("~/.fldigi/fldigi_def.xml")
os.makedirs(os.path.dirname(path), exist_ok=True)
want = {"AUDIOIO": "2", "PULSESERVER": "", "PSKREPAUTO": "0", "PSKREP_AUTOSTART": "0"}   # 2 = PulseAudio
xml = open(path).read() if os.path.exists(path) else '<?xml version="1.0" encoding="UTF-8"?>\n<FLDIGI_DEFS>\n</FLDIGI_DEFS>\n'
for tag, value in want.items():
    if re.search(r"<%s>.*?</%s>" % (tag, tag), xml, re.S):
        xml = re.sub(r"<%s>.*?</%s>" % (tag, tag), "<%s>%s</%s>" % (tag, value, tag), xml, flags=re.S)
    else:
        xml = xml.replace("</FLDIGI_DEFS>", "<%s>%s</%s>\n</FLDIGI_DEFS>" % (tag, value, tag))
open(path, "w").write(xml)
FLDIGI
}
# QSSTV: record from PulseAudio (the default input = the virtual cable)
qsstv_prepare() {
  python3 - <<'QSSTV'
import configparser, os
path = os.path.expanduser("~/.config/ON4QZ/qsstv_9.0.conf")
os.makedirs(os.path.dirname(path), exist_ok=True)
c = configparser.RawConfigParser(); c.optionxform = str
c.read(path)
if not c.has_section("SOUND"):
    c.add_section("SOUND")
c.set("SOUND", "pulseSelected", "true")
c.set("SOUND", "alsaSelected", "false")
c.set("SOUND", "soundRoutingInput", "0")
with open(path, "w") as f:
    c.write(f, space_around_delimiters=False)
QSSTV
}
# JS8Call: same receive-only defaults as WSJT-X (it is a fork). It asks for a callsign on first start.
js8call_prepare() {
  python3 - <<'JS8'
import configparser, os
path = os.path.expanduser("~/.config/JS8Call.ini")
c = configparser.RawConfigParser(); c.optionxform = str
c.read(path)
if not c.has_section("Configuration"):
    c.add_section("Configuration")
for key, value in (("SoundInName", "ubonsole_sdr_in"), ("PSKReporter", "false"),
                   ("SpotToAPRS", "false"), ("AutoreplyOnAtStartup", "false")):
    c.set("Configuration", key, value)
with open(path, "w") as f:
    c.write(f, space_around_delimiters=False)
JS8
}
# RTLSDR-Airband: scans the channels of ~/.config/rtl_airband.conf (asked once, editable after)
# and plays them on the default output. Runs a copy pointed at the chosen dongle.
airband_conf() {
  local conf=~/.config/rtl_airband.conf f
  if [ ! -f "$conf" ]; then
    f=$(rofi -dmenu -p "$L_AIRBAND_PROMPT" -mesg "$L_AIRBAND_MESG" -filter "121.500" -theme "$ROFI_THEME" \
      -theme-str 'window { location: north; anchor: north; y-offset: 32px; width: 560px; } mainbox { children: [ inputbar, message, listview ]; } listview { enabled: false; }' </dev/null | tr ',' ' ')
    f=$(grep -oE '[0-9]+(\.[0-9]+)?' <<< "$f" | paste -sd, - | sed 's/,/, /g')
    [ -z "$f" ] && exit 0
    cat > "$conf" <<AIRBAND
# RTLSDR-Airband, written by the uBonsole radio launcher. Edit freely: the launcher only replaces
# "index" with the dongle you pick. Syntax: https://github.com/rtl-airband/RTLSDR-Airband/wiki
devices:
({
  type = "rtlsdr";
  index = 0;
  gain = 25;
  mode = "scan";
  channels:
  ({
    freqs = ( $f );
    modulation = "am";
    outputs: ({ type = "pulse"; stream_name = "Airband"; });
  });
});
AIRBAND
  fi
  sed "s/^\( *\)index *=.*;/\1index = ${DEV_INDEX:-0};/" "$conf" > "${XDG_RUNTIME_DIR:-/tmp}/rtl_airband.conf"
}
# Band scanner presets: band edges follow the region (ITU region 1 or 2)
scan_bands() {
  case $UBONSOLE_REGION in
    us|ca) SCAN=("88 108" "118 137" "144 148" "420 450" "462.5 467.8" "902 928")
           SCAN_N=("FM" "$L_SCAN_AIR" "2 m" "70 cm" "FRS / GMRS" "ISM 915") ;;
    *)     SCAN=("87.5 108" "118 137" "144 146" "430 440" "446 446.2" "433.05 434.79" "863 870")
           SCAN_N=("FM" "$L_SCAN_AIR" "2 m" "70 cm" "PMR446" "ISM 433" "ISM 868") ;;
  esac
}
# rtl_433 presets: ISM bands follow the region (433.92 / 868 MHz in ITU region 1, 315 / 433.92 / 915 in
# region 2). Fast FSK (868, 915) needs a wider sample rate, Wireless M-Bus C/T and Badger ORION 1.2 MHz
# (rtl_433 -R help). The TPMS decoders are read from rtl_433 itself, so new ones are picked up.
ism_presets() {
  local tpms
  tpms=$(rtl_433 -R help 2>&1 | sed -nE 's/^ +\[0*([0-9]+)\]\*? .*TPMS.*/-R \1/p' | paste -sd' ')
  case $UBONSOLE_REGION in
    us|ca) ISM_N=("$L_ISM_ALL" "$L_ISM_ALL" "$L_ISM_TPMS" "$L_ISM_915" "$L_ISM_ORION" "$L_ISM_HOP" "$L_ISM_PULSE")
           ISM_F=("433.92 MHz" "315 MHz" "315 MHz" "915 MHz" "916.45 MHz" "315 / 433.92 MHz" "433.92 MHz")
           ISM_A=("-f 433.92M" "-f 315M" "-f 315M -s 1000k $tpms" "-f 915M -s 1000k" "-f 916.45M -s 1200k -R 223"
                  "-f 315M -f 433.92M -s 1000k -H 30" "-f 433.92M -A") ;;
    *)     ISM_N=("$L_ISM_ALL" "$L_ISM_TPMS" "$L_ISM_868" "$L_ISM_METERS" "$L_ISM_HOP" "$L_ISM_PULSE")
           ISM_F=("433.92 MHz" "433.92 MHz" "868.3 MHz" "868.95 MHz" "433.92 / 868.3 MHz" "433.92 MHz")
           ISM_A=("-f 433.92M" "-f 433.92M -s 1000k $tpms" "-f 868.3M -s 1000k" "-f 868.95M -s 1200k -R 104"
                  "-f 433.92M -f 868.3M -s 1000k -H 30" "-f 433.92M -A") ;;
  esac
}
# ACARS Hub (Docker): web view of the ACARS / VDL2 messages. The decoders always send JSON to its UDP
# ports (5550 ACARS, 5555 VDL2), which are published on 127.0.0.1 only; nothing goes to the network.
ACARSHUB_IMAGE=ghcr.io/sdr-enthusiasts/docker-acarshub:latest
ACARS_CMD() { echo "acarsdec -o 2 -j 127.0.0.1:5550 -r $DEV_INDEX 131.525 131.725 131.825"; }
VDL2_CMD() {
  echo "dumpvdl2 --output decoded:text:file:path=- --output decoded:json:udp:address=127.0.0.1,port=5555" \
    "--rtlsdr $DEV_INDEX --gain $SDR_GAIN 136725000 136775000 136875000 136975000"
}
# docker without the docker group: password-less sudo
dk() { docker "$@" 2>/dev/null || sudo -n docker "$@"; }
has_acarshub() { has docker && dk image inspect "$ACARSHUB_IMAGE" >/dev/null 2>&1; }
# Created on first use, from the settings: time zone of the system, tar1090 for the aircraft map
acarshub_start() {
  if ! dk container inspect acarshub >/dev/null 2>&1; then
    mkdir -p ~/.local/share/acarshub
    dk create --name acarshub --restart no \
      -p 127.0.0.1:8080:80 -p 127.0.0.1:5550:5550/udp -p 127.0.0.1:5555:5555/udp \
      --add-host host.docker.internal:host-gateway \
      --tmpfs /database:exec,size=64M --tmpfs /run:exec,size=64M --tmpfs /var/log:size=64M \
      -v "$HOME/.local/share/acarshub:/run/acars" \
      -e TZ="$(timedatectl show -p Timezone --value 2>/dev/null || echo Etc/UTC)" \
      -e ENABLE_ACARS=true -e ACARS_CONNECTIONS=udp -e ENABLE_VDLM=true -e VDLM_CONNECTIONS=udp \
      -e DB_SAVEALL=true -e MIN_LOG_LEVEL=3 \
      -e ENABLE_ADSB=true -e ADSB_URL="${TAR1090_URL/localhost/host.docker.internal}/data/aircraft.json" \
      "$ACARSHUB_IMAGE" >/dev/null || return 1
  fi
  dk start acarshub >/dev/null
}
# Audio modes need rtl_fm and the PipeWire tools (pipewire-bin) for the virtual cable
need_audio() {
  has rtl_fm || missing rtl_fm
  for t in pw-loopback pw-cat pw-dump wpctl; do has "$t" || missing "$t (PipeWire)"; done
}
start_app() { pgrep -x "$1" >/dev/null || setsid -f "$1" >/dev/null 2>&1; }

# shellcheck disable=SC2059
missing() { rofi -e "$(printf "$L_IS_NOT_INSTALLED" "$1")" "${THEME[@]}"; exit 0; }

# Apps grouped by use. "#" rows are group titles (bold); picking one shows the menu again.
ITEMS=(
  "#" "$L_GRP_AIR"
  adsb "$L_APP_ADSB"
  acars "$L_APP_ACARS$(mark acarsdec)"
  vdl2 "$L_APP_VDL2$(mark dumpvdl2)"
  acarshub "$L_APP_ACARSHUB$(has_acarshub || echo "  $L_NOT_INSTALLED")"
  airband "$L_APP_AIRBAND$(mark rtl_airband)"
  ais "$L_APP_AIS$(mark AIS-catcher)"
  "#" "$L_GRP_RADIO"
  gqrx "GQRX$(mark gqrx)"
  sdrpp "SDR++$(mark sdrpp)"
  dab "$L_APP_DAB$(mark welle-io)"
  scan "$L_APP_SCAN$(mark rtl_power)"
  listen "$L_APP_LISTEN$(~/.config/i3/scripts/sdr-audio listening && echo " · ON")"
  "#" "$L_GRP_SAT"
  satdump "$L_APP_SATDUMP$(mark satdump-ui)"
  gpredict "$L_APP_GPREDICT$(mark gpredict)"
  sondes "$L_APP_SONDES$([ -f "$AUTORX_DIR/auto_rx.py" ] || echo "  $L_NOT_INSTALLED")"
  "#" "$L_GRP_HAM"
  aprs "$L_APP_APRS$(mark direwolf)"
  ft8 "$L_APP_FT8$(mark wsjtx)"
  js8 "$L_APP_JS8$(mark js8call)"
  sstv "$L_APP_SSTV$(mark qsstv)"
  fldigi "$L_APP_FLDIGI$(mark fldigi)"
  "#" "$L_GRP_OTHER"
  ism "$L_APP_433$(mark rtl_433)"
  meshcore "$L_APP_MESHCORE$(mark meshcore-console)"
  gps "$L_APP_GPS$(mark gpspipe)"
  "#" ""
  stop "$L_APP_STOP"
)
markup_escape() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "$1"; }
IDS=(); LABELS=()
for ((i = 0; i < ${#ITEMS[@]}; i += 2)); do
  IDS+=("${ITEMS[i]}")
  if [ "${ITEMS[i]}" = "#" ]; then
    LABELS+=("<b>$(markup_escape "${ITEMS[i + 1]}")</b>")
  else
    LABELS+=("   $(markup_escape "${ITEMS[i + 1]}")")
  fi
done
ROW=1
# Tighter rows than the other menus so every app fits on the 720 px screen
while :; do
  CHOICE=$(printf '%s\n' "${LABELS[@]}" | rofi -dmenu -p radio -i -no-custom -markup-rows -format i \
    -selected-row "$ROW" "${THEME[@]}" -theme-str "listview { lines: ${#LABELS[@]}; } element { padding: 1px 6px; }")
  [ -z "$CHOICE" ] && exit 0
  [ "${IDS[$CHOICE]}" != "#" ] && break
  ROW=$((CHOICE + 1))   # a group title: back to the menu, on its first app
done

case ${IDS[$CHOICE]} in
  adsb) pick_sdr; free_sdr; setsid -f ~/.config/i3/scripts/adsb "${DEV_SERIAL:-$DEV_INDEX}" >/dev/null 2>&1 ;;
  gqrx) has gqrx || missing GQRX; free_sdr; setsid -f gqrx >/dev/null 2>&1 ;;
  sdrpp) has sdrpp || missing SDR++; free_sdr; setsid -f sdrpp >/dev/null 2>&1 ;;
  satdump) has satdump-ui || missing SatDump; free_sdr; setsid -f satdump-ui >/dev/null 2>&1 ;;
  sondes) [ -f "$AUTORX_DIR/auto_rx.py" ] || missing radiosonde_auto_rx; free_sdr
     term "Radiosondes" "cd '$AUTORX_DIR' && ./venv/bin/python auto_rx.py" "400-406 MHz (http://localhost:5000)"
     (sleep 15; firefox --new-tab http://localhost:5000 >/dev/null 2>&1) & ;;
  acars) has acarsdec || missing acarsdec; pick_sdr; free_sdr
     term "ACARS" "$(ACARS_CMD)" "131.525 / 131.725 / 131.825 MHz" ;;
  vdl2) has dumpvdl2 || missing dumpvdl2; pick_sdr; free_sdr
     term "VDL2" "$(VDL2_CMD)" "136.725 - 136.975 MHz" ;;
  acarshub) has_acarshub || missing "ACARS Hub (tools/install-sdr-tools.sh)"
     k=$(pick "ACARS Hub" "$L_APP_VDL2$(mark dumpvdl2)" "$L_APP_ACARS$(mark acarsdec)"); [ -z "$k" ] && exit 0
     if [ "$k" = 0 ]; then has dumpvdl2 || missing dumpvdl2; else has acarsdec || missing acarsdec; fi
     acarshub_start || { rofi -e "$L_ACARSHUB_FAILED" "${THEME[@]}"; exit 0; }
     pick_sdr; free_sdr
     if [ "$k" = 0 ]; then term "VDL2" "$(VDL2_CMD)" "136.725 - 136.975 MHz (http://localhost:8080)"
     else term "ACARS" "$(ACARS_CMD)" "131.525 / 131.725 / 131.825 MHz (http://localhost:8080)"; fi
     (sleep 15; firefox --new-tab http://localhost:8080 >/dev/null 2>&1) & ;;
  aprs) has direwolf || missing direwolf; has rtl_fm || missing rtl_fm
     # Terrestrial APRS is 144.390 MHz in North America, 144.800 MHz elsewhere; the ISS digipeater
     # is 145.825 MHz everywhere
     case $UBONSOLE_REGION in us|ca) F=144.390 ;; *) F=144.800 ;; esac
     k=$(pick APRS "APRS · $F MHz" "ISS · 145.825 MHz"); [ -z "$k" ] && exit 0
     [ "$k" = 1 ] && F=145.825
     pick_sdr; free_sdr
     term "APRS" "rtl_fm -d $DEV_INDEX -f ${F}M -s 24000 -g $SDR_GAIN - | direwolf -c ~/.config/direwolf/sdr.conf -r 24000 -D 1 -t 0 -" "$F MHz" ;;
  # -X off: AIS-catcher shares what it receives with aiscatcher.org unless told not to
  ais) has AIS-catcher || missing AIS-catcher; pick_sdr; free_sdr
     term "AIS" "AIS-catcher -d:$DEV_INDEX -gr TUNER $SDR_GAIN -N 8100 -X off" "161.975 / 162.025 MHz (http://localhost:8100)"
     (sleep 6; firefox --new-tab http://localhost:8100 >/dev/null 2>&1) & ;;
  airband) has rtl_airband || missing RTLSDR-Airband; pick_sdr; airband_conf; free_sdr
     term "Airband" "rtl_airband -f -e -c '${XDG_RUNTIME_DIR:-/tmp}/rtl_airband.conf'" \
       "$(sed -n 's/^ *freqs *= *( *\(.*[^ ]\) *);.*/\1/p' ~/.config/rtl_airband.conf | head -1) MHz" ;;
  dab) has welle-io || missing welle.io; free_sdr; setsid -f welle-io >/dev/null 2>&1 ;;
  gpredict) has gpredict || missing Gpredict; start_app gpredict ;;
  listen) ~/.config/i3/scripts/sdr-audio listen || rofi -e "$L_LISTEN_NOTHING" "${THEME[@]}" ;;
  scan) has rtl_power || missing rtl_power; scan_bands
     L=(); for i in "${!SCAN[@]}"; do read -r a b <<< "${SCAN[i]}"; L+=("${SCAN_N[i]} · $a - $b MHz"); done
     k=$(pick scan "${L[@]}" "$L_OTHER_RANGE"); [ -z "$k" ] && exit 0
     if [ "$k" -lt "${#SCAN[@]}" ]; then
       read -r a b <<< "${SCAN[k]}"
     else
       r=$(rofi -dmenu -p "$L_SCAN_PROMPT" -theme "$ROFI_THEME" -theme-str 'window { location: north; anchor: north; y-offset: 32px; width: 560px; } mainbox { children: [ inputbar, listview ]; } listview { enabled: false; }' </dev/null | tr ',' '.')
       [[ $r =~ ^\ *([0-9]+(\.[0-9]+)?)\ *-\ *([0-9]+(\.[0-9]+)?)\ *$ ]] || exit 0
       a=${BASH_REMATCH[1]} b=${BASH_REMATCH[3]}
       awk -v a="$a" -v b="$b" 'BEGIN { exit !(b > a) }' || exit 0
     fi
     pick_sdr
     # rtl_power has no Q-branch direct sampling: HF only with the V4's upconverter
     if awk -v f="$a" 'BEGIN { exit !(f < 24) }'; then
       case $DEV_NAME in *"Blog V4"*) ;; *) rofi -e "$L_SCAN_HF" "${THEME[@]}"; exit 0 ;; esac
     fi
     free_sdr
     term "Scan" "~/.config/i3/scripts/band-scan ${DEV_INDEX:-$SDR_DEVICE} $SDR_GAIN $a $b 60" "$a - $b MHz" ;;
  ft8) has wsjtx || missing WSJT-X; need_audio
     # FT8 / FT4 dial frequencies (USB), the same worldwide; below 24 MHz needs HF direct sampling
     F=(144.174 50.313 28.074 21.074 14.074 7.074 14.080 7.0475)
     M=(FT8 FT8 FT8 FT8 FT8 FT8 FT4 FT4)
     N=("2 m" "6 m" "10 m" "15 m" "20 m" "40 m" "20 m" "40 m")
     L=(); for i in "${!F[@]}"; do L+=("${M[i]} · ${N[i]} · ${F[i]} MHz$(awk -v f="${F[i]}" 'BEGIN { if (f < 24) print "  (HF)" }')"); done
     k=$(pick FT8 "${L[@]}"); [ -z "$k" ] && exit 0
     pick_sdr; free_sdr; audio_rx "${F[k]}" usb "${M[k]}"
     wsjtx_prepare "${M[k]}"; start_app wsjtx ;;
  js8) has js8call || missing JS8Call; need_audio
     # JS8Call dial frequencies (USB)
     F=(144.178 50.318 28.078 14.078 10.130 7.078 3.578)
     N=("2 m" "6 m" "10 m" "20 m" "30 m" "40 m" "80 m")
     L=(); for i in "${!F[@]}"; do L+=("${N[i]} · ${F[i]} MHz$(awk -v f="${F[i]}" 'BEGIN { if (f < 24) print "  (HF)" }')"); done
     k=$(pick JS8 "${L[@]}"); [ -z "$k" ] && exit 0
     pick_sdr; free_sdr; audio_rx "${F[k]}" usb JS8
     js8call_prepare; start_app js8call ;;
  sstv) has qsstv || missing QSSTV; need_audio
     k=$(pick SSTV "ISS · 145.800 MHz · FM" "20 m · 14.230 MHz · USB  (HF)" "$L_OTHER_FREQ"); [ -z "$k" ] && exit 0
     pick_sdr; free_sdr
     case $k in 0) audio_rx 145.800 fm SSTV ;; 1) audio_rx 14.230 usb SSTV ;; *) custom_rx SSTV ;; esac
     qsstv_prepare; start_app qsstv ;;
  fldigi) has fldigi || missing fldigi; need_audio
     # Dial frequencies (USB) put CW about 600 Hz and RTTY / NAVTEX about 1 kHz up in fldigi's waterfall
     k=$(pick fldigi "NAVTEX · 518 kHz  (HF)" "CW · 20 m · 14.025 MHz  (HF)" "RTTY · 20 m · 14.083 MHz  (HF)" "$L_OTHER_FREQ"); [ -z "$k" ] && exit 0
     pick_sdr; free_sdr
     case $k in 0) audio_rx 0.517 usb NAVTEX ;; 1) audio_rx 14.0244 usb CW ;; 2) audio_rx 14.082 usb RTTY ;; *) custom_rx fldigi ;; esac
     fldigi_prepare; start_app fldigi ;;
  ism) has rtl_433 || missing rtl_433; ism_presets
     L=(); for i in "${!ISM_N[@]}"; do L+=("${ISM_N[i]} · ${ISM_F[i]}"); done
     k=$(pick "RTL 433" "${L[@]}" "$L_OTHER_FREQ"); [ -z "$k" ] && exit 0
     if [ "$k" -lt "${#ISM_N[@]}" ]; then F=${ISM_F[k]} A=${ISM_A[k]}
     else
       f=$(rofi -dmenu -p "$L_FREQ_PROMPT" -theme "$ROFI_THEME" -theme-str 'window { location: north; anchor: north; y-offset: 32px; width: 560px; } mainbox { children: [ inputbar, listview ]; } listview { enabled: false; }' </dev/null | tr ',' '.')
       [[ $f =~ ^[0-9]+(\.[0-9]+)?$ ]] || exit 0
       F="$f MHz" A="-f ${f}M -s 1000k"
     fi
     pick_sdr; free_sdr; term "RTL 433" "rtl_433 -d $DEV_INDEX $A" "$F" ;;
  meshcore) has meshcore-console || missing Meshcore; aio LORA on >/dev/null 2>&1; setsid -f meshcore-console >/dev/null 2>&1 ;;
  gps) has gpspipe || missing "gpspipe (gpsd-clients)"; setsid -f ~/.config/i3/scripts/gps-info >/dev/null 2>&1 ;;
  stop) free_sdr; has docker && dk stop acarshub >/dev/null 2>&1 ;;
esac
pkill -RTMIN+13 i3blocks
