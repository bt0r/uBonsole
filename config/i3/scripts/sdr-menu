#!/bin/bash
# Radio app launcher (rofi). Only one SDR app at a time: the dongle is freed before each launch.
. ~/.config/i3/scripts/common.sh
pkill -f "rofi -dmenu -p radio" && exit 0

THEME=(-theme "$ROFI_THEME" -theme-str 'window { location: north; anchor: north; y-offset: 32px; width: 560px; } listview { lines: 12; } mainbox { children: [ listview ]; }')

has() { command -v "$1" >/dev/null 2>&1; }
mark() { has "$1" || echo "  $L_NOT_INSTALLED"; }

free_sdr() {
  pkill -x gqrx; pkill -x sdrpp; pkill -x satdump-ui; pkill -x satdump
  pkill -x rtl_433; pkill -x rtl_fm; pkill -x acarsdec; pkill -x dumpvdl2; pkill -x direwolf
  pkill -f auto_rx.py; pkill -f scripts/adsb
  systemctl is-active -q "$ADSB_SERVICE" && sudo -n systemctl stop "$ADSB_SERVICE"
  # Power the AIO v2 SDR if it is off (no-op without the board)
  if has_aio && ! aio 2>/dev/null | grep -q '^SDR: ON'; then aio SDR on >/dev/null 2>&1; sleep 2; fi
  sleep 1
}
# Text-mode decoder in a terminal (workspace 3) that stays open when it exits
term() {
  # Translated strings go through the environment so quotes in them are safe
  # shellcheck disable=SC2059
  BANNER=$(printf "$L_LISTENING" "$3") CLOSE=$L_PRESS_ENTER_CLOSE \
    setsid -f st -c sdr-term -t "$1" -e bash -c 'echo "$BANNER"; echo; '"$2"'; read -rp "$CLOSE"' >/dev/null 2>&1
}
# shellcheck disable=SC2059
missing() { rofi -e "$(printf "$L_IS_NOT_INSTALLED" "$1")" "${THEME[@]}"; exit 0; }

ITEMS=(
  "$L_APP_ADSB"
  "GQRX$(mark gqrx)"
  "SDR++$(mark sdrpp)"
  "$L_APP_SATDUMP$(mark satdump-ui)"
  "$L_APP_SONDES$([ -f "$AUTORX_DIR/auto_rx.py" ] || echo "  $L_NOT_INSTALLED")"
  "$L_APP_ACARS$(mark acarsdec)"
  "$L_APP_VDL2$(mark dumpvdl2)"
  "$L_APP_APRS$(mark direwolf)"
  "$L_APP_433$(mark rtl_433)"
  "$L_APP_MESHCORE$(mark meshcore-console)"
  "$L_APP_GPS$(mark xgps)"
  "$L_APP_STOP"
)
CHOICE=$(printf '%s\n' "${ITEMS[@]}" | rofi -dmenu -p radio -i -no-custom -format i "${THEME[@]}")
[ -z "$CHOICE" ] && exit 0

case $CHOICE in
  0) free_sdr; setsid -f ~/.config/i3/scripts/adsb >/dev/null 2>&1 ;;
  1) has gqrx || missing GQRX; free_sdr; setsid -f gqrx >/dev/null 2>&1 ;;
  2) has sdrpp || missing SDR++; free_sdr; setsid -f sdrpp >/dev/null 2>&1 ;;
  3) has satdump-ui || missing SatDump; free_sdr; setsid -f satdump-ui >/dev/null 2>&1 ;;
  4) [ -f "$AUTORX_DIR/auto_rx.py" ] || missing radiosonde_auto_rx; free_sdr
     term "Radiosondes" "cd '$AUTORX_DIR' && ./venv/bin/python auto_rx.py" "400-406 MHz (http://localhost:5000)"
     (sleep 15; firefox --new-tab http://localhost:5000 >/dev/null 2>&1) & ;;
  5) has acarsdec || missing acarsdec; free_sdr
     term "ACARS" "acarsdec -o 2 -r $SDR_DEVICE 131.525 131.725 131.825" "131.525 / 131.725 / 131.825 MHz" ;;
  6) has dumpvdl2 || missing dumpvdl2; free_sdr
     term "VDL2" "dumpvdl2 --rtlsdr $SDR_DEVICE --gain $SDR_GAIN 136725000 136775000 136875000 136975000" "136.725 - 136.975 MHz" ;;
  7) has direwolf || missing direwolf; has rtl_fm || missing rtl_fm; free_sdr
     term "APRS" "rtl_fm -d $SDR_DEVICE -f 144.800M -s 24000 -g $SDR_GAIN - | direwolf -c ~/.config/direwolf/sdr.conf -r 24000 -D 1 -t 0 -" "144.800 MHz" ;;
  8) has rtl_433 || missing rtl_433; free_sdr; term "433 MHz" "rtl_433 -d $SDR_DEVICE -f 433.92M" "433.92 MHz" ;;
  9) has meshcore-console || missing Meshcore; aio LORA on >/dev/null 2>&1; setsid -f meshcore-console >/dev/null 2>&1 ;;
  10) has xgps || missing xgps; aio GPS on >/dev/null 2>&1; setsid -f xgps >/dev/null 2>&1 ;;
  11) free_sdr ;;
esac
pkill -RTMIN+13 i3blocks
