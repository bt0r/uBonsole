#!/usr/bin/env python3
"""Opens the session menu with the SELECT button of the uConsole.

The gamepad buttons of the uConsole keyboard belong to a joystick input device, which X ignores, so
i3 cannot bind them. This small listener, started by i3, reads that device and runs the session menu
when SELECT (BTN_BASE3) is pressed. Presses are ignored while the focused window is fullscreen,
since games use SELECT. Needs read access to /dev/input (the "input" group).
"""
import json
import os
import signal
import struct
import subprocess
import time

DEVICE_NAME = "ClockworkPI uConsole"   # the joystick part of the keyboard
BUTTONS = {296: "session-menu"}        # BTN_BASE3 = SELECT -> script in ~/.config/i3/scripts
EV_KEY = 1
EVENT = struct.Struct("llHHi")          # struct input_event: timeval, type, code, value
SCRIPTS = os.path.expanduser("~/.config/i3/scripts")
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ubonsole-gamepad-buttons.pid")


def replace_previous_instance():
    """i3 runs this on every restart (exec_always): stop the old listener, then record ours."""
    try:
        pid = int(open(PIDFILE).read())
        if pid != os.getpid() and b"gamepad-buttons" in open("/proc/%d/cmdline" % pid, "rb").read():
            os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))


def find_device():
    """Returns /dev/input/eventN of the uConsole joystick, or None."""
    name = None
    with open("/proc/bus/input/devices") as f:
        for line in f:
            if line.startswith("N: Name="):
                name = line.split("=", 1)[1].strip().strip('"')
            elif line.startswith("H: Handlers=") and name == DEVICE_NAME:
                handlers = line.split("=", 1)[1].split()
                events = [h for h in handlers if h.startswith("event")]
                if events and any(h.startswith("js") for h in handlers):
                    return "/dev/input/" + events[0]
    return None


def focused_is_fullscreen():
    try:
        tree = json.loads(subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True, timeout=2).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return False
    stack = [tree]
    while stack:
        node = stack.pop()
        if node.get("focused"):
            # i3 marks workspaces as fullscreen_mode 1: only a real window counts
            return bool(node.get("window")) and node.get("fullscreen_mode", 0) != 0
        stack += node.get("nodes", []) + node.get("floating_nodes", [])
    return False


def listen(path):
    with open(path, "rb") as dev:
        while True:
            data = dev.read(EVENT.size)
            if len(data) < EVENT.size:
                return
            _, _, etype, code, value = EVENT.unpack(data)
            if etype == EV_KEY and value == 1 and code in BUTTONS and not focused_is_fullscreen():
                subprocess.Popen([os.path.join(SCRIPTS, BUTTONS[code])], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    replace_previous_instance()
    while True:                         # survives the keyboard being unplugged or not ready yet
        path = find_device()
        if path:
            try:
                listen(path)
            except OSError:
                pass
        time.sleep(5)


if __name__ == "__main__":
    main()
