#!/bin/bash
# i3blocks: Wi-Fi. Icon + IP when connected, icon alone when not connected, crossed-out icon when
# the Wi-Fi radio is off. Right click copies the IP. Refreshed by signal 14 (power menu toggle).
. ~/.config/i3/scripts/common.sh
ICON=$'\uf1eb'
ZWSP=$'\u200b'   # zero-width space, carries the right margin of the "off" icon

radio_off() {
  if command -v nmcli >/dev/null 2>&1; then
    [ "$(nmcli radio wifi 2>/dev/null)" = disabled ] && return 0
  fi
  /usr/sbin/rfkill -n -o TYPE,SOFT,HARD list 2>/dev/null | grep -E '^wlan' | grep -q -w blocked
}

if radio_off; then
  # FontAwesome 4.7 has no "Wi-Fi off" glyph: a negative letter spacing pulls a slash over the
  # icon (markup=pango). Measured with the 14 pt bar font: -30000 centers the slash on the icon; a
  # zero-width space spaced by +10000 then restores the usual 8 px block margin without moving the
  # slash (Pango splits letter spacing on both sides of a glyph).
  echo "<span letter_spacing=\"-30000\">$ICON</span><span font_desc=\"DejaVu Sans Bold 18\">/</span><span letter_spacing=\"10000\">$ZWSP</span>"
  exit 0
fi

IP=$(ip -4 -o addr show dev "$WIFI_IFACE" scope global 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }')
[ "$BLOCK_BUTTON" = 3 ] && [ -n "$IP" ] && printf '%s' "$IP" | xclip -selection clipboard 2>/dev/null
echo "$ICON${IP:+ $IP}"
